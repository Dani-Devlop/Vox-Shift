{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@/*": ["../../src/*"] }
  },
  "include": ["*.ts", "engines/*.ts", "providers/*.ts", "../../src/lib/**/*.ts"]
}

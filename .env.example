# ── VoxShift environment ─────────────────────────────────────────────────────
# Copy to .env and adjust. Only DATABASE_URL is required; everything else has
# an honest fallback that is labeled in the UI.

# SQLite database (profiles, threads, history, phrasebook)
DATABASE_URL=file:./db/voxshift.db

# Extra entropy for encrypting user-provided provider API keys (AES-256-GCM).
# A machine secret is auto-generated in db/.provider-secret regardless.
# APP_SECRET=

# Enables REAL cross-language voice cloning (ElevenLabs Instant Voice Cloning).
# Without it VoxShift runs in honest pitch-conformed voice-match mode.
# ELEVENLABS_API_KEY=

# Realtime service probe target for the Diagnostics self-test.
# TRANSLATOR_SERVICE_URL=http://127.0.0.1:3003

# Root of local runtime models (vosk / piper model dirs) when not on the
# default path. Local runtimes are detected by REAL probes only — if a runtime
# or model is missing, the chain skips it and reports that honestly.
# VOXSHIFT_MODELS_DIR=/opt/voxshift/models

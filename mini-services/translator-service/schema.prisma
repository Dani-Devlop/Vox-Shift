generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Identity ─────────────────────────────────────────────────────────────────
// Anonymous, cookie-scoped user (vox_uid). No passwords — the cookie is the
// identity. All owned records hang off this row so a second browser cannot
// read another user's threads (checked server-side on every API route).

model User {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  lastSeenAt    DateTime @default(now()) @updatedAt
  prefsJson     String? // global UI/translation preferences (JSON)
  conversations Conversation[]
  voiceProfiles VoiceProfile[]
  historyEntries HistoryEntry[]
  voiceContacts VoiceContact[]
  providerConfigs UserProviderConfig[]

  @@index([lastSeenAt])
}

// ── Voice identity ───────────────────────────────────────────────────────────
// Voice profile built from the user's voice sample. MVP strategy: analyze
// acoustic features (pitch, brightness, tempo) and map to the closest engine
// TTS voice + speed adjustment. The Voice Engine layer is modular so a real
// voice-cloning engine can replace this later.
// HONESTY: `mode` records what the profile actually is. "voice-match" =
// estimated closest-slot mapping (NOT a clone). A provider that supports true
// cloning would store mode "clone" + providerProfileId.

model VoiceProfile {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String   @default("My Voice")
  isActive         Boolean  @default(true)
  /// Capability honesty: "voice-match" (estimated) | "clone" (provider-cloned)
  mode             String   @default("voice-match")
  /// When the user consented to voice-sample analysis (enrollment consent).
  consentAt        DateTime?
  meanF0           Float // mean fundamental frequency (Hz)
  f0Std            Float // pitch variability (Hz)
  f0Min            Float
  f0Max            Float
  spectralCentroid Float // brightness (Hz)
  estimatedGender  String // "male" | "female" | "neutral"
  voiceCharacter   String // human-friendly descriptor e.g. "Warm · Medium"
  mappedVoice      String // engine voice id e.g. "jam"
  speedAdjust      Float    @default(1.0) // 0.5..2.0 TTS speed factor
  /// Pitch-conformance ratio: user's measured mean F0 ÷ engine voice's center
  /// F0. The synthesis stage shifts output pitch by this factor (TTS speed
  /// compensation + resampling) so the generated audio follows the user's
  /// register. 1.0 = no shift. Clamped to [0.75, 1.33] for quality.
  pitchRatio       Float    @default(1.0)
  speakingRate     Float // estimated syllables/sec
  sampleDuration   Float // seconds of analyzed audio
  /// Sample-quality diagnostics captured at enrollment (§5.2 feedback):
  /// fraction of clipped samples and approximate signal-to-noise ratio (dB).
  clippingRatio    Float    @default(0)
  snrDb            Float    @default(0)
  engine           String   @default("zai-tts") // voice engine identifier (swappable)
  /// Provider-side profile id (used by cloning engines; null for voice-match).
  providerProfileId String?
  /// Cloning model key used by the provider ('balanced' | 'quality'); null for voice-match.
  providerModel    String?
  /// Cloner stability 0..1 (higher = steadier, lower = more expressive).
  stability        Float    @default(0.5)
  /// Provider similarity boost 0..1 (clone mode only; higher = closer match).
  providerSimilarity Float  @default(0.8)
  /// Provider style exaggeration 0..0.45 (clone mode only).
  providerStyle    Float    @default(0.0)
  /// Number of voice samples merged into this profile (1..3 takes).
  sampleCount      Int      @default(1)
  /// Local-clone (v3.3.1): on-box reference WAV path (db/audio/clone-ref/{id}.wav).
  /// The tone-color embedding cache lives in /home/z/models/voice-clone/{id}.se.
  refAudioPath     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, isActive])
}

// ── Persisted translation history (global phrasebook) ────────────────────────
model HistoryEntry {
  id             String  @id @default(cuid())
  userId         String?
  user           User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceText     String
  translatedText String
  sourceLang     String  @default("fa")
  targetLang     String  @default("en")
  style          String  @default("natural")
  voice          String  @default("default")
  timingsJson    String // JSON: { asrMs, translateMs, ttsMs, totalMs }
  hasAudio       Boolean @default(false)
  /// User-starred phrase (phrasebook).
  starred        Boolean @default(false)
  /// Client-generated session grouping id (one start→stop cycle = one session).
  sessionId      String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId])
  @@index([userId, createdAt])
}

// ── Conversations (threads) ──────────────────────────────────────────────────
// A thread is a persistent, resumable conversation. Settings overrides let a
// thread carry its own language pair / style / voice without touching the
// user's global defaults.

model Conversation {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String   @default("New conversation")
  /// Default direction for the thread (informational; overrides win).
  sourceLang     String   @default("fa")
  targetLang     String   @default("en")
  /// Thread settings overrides JSON: { style?, mode?, otherLang?, voiceMode?,
  /// playbackRate?, bigButton? } — absent keys inherit global preferences.
  overridesJson  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastActivityAt DateTime @default(now())
  sessions       ConversationSession[]
  messages       Message[]
  speakers       ConversationSpeaker[]

  @@index([userId, lastActivityAt])
}

// A session is one recording / live-interaction period inside a thread.
model ConversationSession {
  id             String         @id @default(cuid())
  conversationId String
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  status         String         @default("live") // live | ended
  startedAt      DateTime       @default(now())
  endedAt        DateTime?
  messages       Message[]

  @@index([conversationId, startedAt])
}

// One translated utterance inside a thread (source ↔ translation pair).
// Audio replay reuses the HistoryEntry audio cache via historyEntryId —
// no duplicate audio storage.
model Message {
  id               String              @id @default(cuid())
  conversationId   String
  conversation     Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sessionId        String?
  session          ConversationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  sequenceNo       Int
  speakerRole      String              @default("user") // user | other
  sourceLang       String
  targetLang       String
  sourceText       String
  translatedText   String
  style            String              @default("natural")
  voice            String              @default("default")
  timingsJson      String?
  /// HistoryEntry owning the disk-cached audio (replay via /api/history/{id}/audio).
  historyEntryId   String?
  /// complete | failed
  processingStatus String              @default("complete")
  /// Speaker recognition attribution (master prompt v2 §12/§28) — stable
  /// temporary cluster id + resolved display name + honest status/confidence.
  speakerKey          String?
  speakerContactId    String?
  speakerName         String?
  identificationStatus String?
  speakerConfidence   Float?
  createdAt        DateTime            @default(now())

  @@index([conversationId, sequenceNo])
  @@index([sessionId])
}

// ── Voice Contacts (persistent speaker recognition, master prompt v2) ───────
// A Voice Contact is a NAMED person the system can recognize again by voice.
// Recognition is LOCAL-FIRST: a voiceprint (pitch + spectral-timbre vector)
// is computed on-device/server from reference audio and matched by cosine
// similarity — no cloud, no vendor lock-in. HONESTY: this is a lightweight
// spectral voiceprint, not a deep x-vector model — great at telling different
// people apart, weaker for near-identical voices. The UI discloses this.
model VoiceContact {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  language         String? // primary spoken language of the sample
  /// Voiceprint vector (JSON float array, dim = vectorDim), L2-normalized.
  embeddingJson    String
  vectorDim        Int
  /// Reference audio kept on disk (db/audio/contacts/{id}.wav) for playback
  /// and re-enrollment. Nullable only for legacy/failed rows.
  referenceAudio   String?
  sampleDuration   Float     @default(0) // seconds of usable speech kept
  /// Enrollment quality metrics JSON { meanF0, snrDb, speechSec, frames }.
  qualityJson      String?
  /// Per-contact recognition threshold (cosine similarity 0.5..0.99).
  confidenceThreshold Float  @default(0.9)
  /// Recognition statistics (honest, measured — never invented).
  matchCount       Int       @default(0)
  lastMatchConfidence Float?
  lastMatchAt      DateTime?
  /// Temporarily disable recognition without deleting the profile.
  disabled         Boolean   @default(false)
  /// Explicit user consent timestamp (enrollment requires consent).
  consentAt        DateTime?
  /// Optional link to a VoiceProfile (clone) — future: speak AS this person.
  voiceProfileId   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, updatedAt])
}

// ── User-provided API providers (master prompt v2 §24) ──────────────────────
// Users can register their own provider endpoints (OpenAI-compatible base
// URLs) for ASR / Translation / TTS. Keys are ENCRYPTED AT REST with
// AES-256-GCM and NEVER returned to the frontend (masked hint only) and NEVER
// logged. Priority orders the failover chain (lower = tried first); the
// built-in z-ai engines stay as the final fallback.
model UserProviderConfig {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// asr | translate | llm | tts
  category  String
  /// openai-compatible (extensible)
  kind      String   @default("openai-compatible")
  /// Provider class (v3 §15): server | cloud | custom
  class     String   @default("custom")
  name      String
  baseUrl   String
  model     String?
  voiceId   String?
  /// Extra HTTP headers (v3 §24) — JSON object; values never returned to UI.
  headersJson String?
  /// AES-256-GCM ciphertext "iv:tag:data" hex — plaintext never stored.
  encKey    String?
  /// Last 4 chars of the key for UI identification. Never the key itself.
  keyHint   String?
  priority  Int      @default(50)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, category, priority])
}

// ── Per-conversation speaker registry (stable temporary IDs) ────────────────
// Maps a session cluster key (spk_001…) to a name/contact so unknown speakers
// keep the SAME temporary ID within a conversation and identified labels
// survive app restarts. speakerId clusters are conversation-scoped on purpose.
model ConversationSpeaker {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Stable temporary speaker id within the conversation, e.g. "spk_001".
  clusterKey     String
  /// VoiceContact assigned by the user (null while unknown).
  contactId      String?
  /// Display name (contact name, user correction, or "Unknown 1").
  displayName    String?
  /// Last known voiceprint for this speaker (JSON float array) — seeds
  /// recognition when the conversation is reopened.
  embeddingJson  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([conversationId, clusterKey])
  @@index([conversationId])
}
